    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const testo = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!testo) {\n  throw new Error('Risposta Gemini priva del campo text');\n}\n\nconst risultato = JSON.parse(testo);\n\nconst origine = {\n  ...$('Prepara Immagine Base64').item.json\n};\n\ndelete origine.immagine_base64;\n\nreturn {\n  json: {\n    ...origine,\n    ...risultato,\n\n    verifica_colore_eseguita: true,\n\n    token_input_colore:\n      $json.usageMetadata?.promptTokenCount ?? null,\n\n    token_output_colore:\n      $json.usageMetadata?.candidatesTokenCount ?? null,\n\n    token_totali_colore:\n      $json.usageMetadata?.totalTokenCount ?? null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -64
      ],
      "id": "09d525ea-514f-4b8a-acfa-1aad234b8284",
      "name": "Parsing"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"inline_data\": {\n            \"mime_type\": \"{{ $json.mime_type_immagine }}\",\n            \"data\": \"{{ $json.immagine_base64 }}\"\n          }\n        },\n        {\n          \"text\": \"Analizza esclusivamente la resa cromatica di questa fotografia immobiliare. Il tuo compito NON è stabilire se i colori corrispondano sicuramente alla realtà dell'immobile, perché non puoi conoscerla. Devi soltanto valutare se la resa cromatica appare plausibile oppure se mostra indizi forti di una possibile alterazione artificiale. Considera normale una fotografia naturalmente calda o fredda dovuta a illuminazione interna, luce solare, parquet, legno, pareti beige o colorate, arredi o materiali presenti nella scena. Non classificare come sospetta una foto solo perché appare calda, fredda, satura o desaturata. Restituisci 'sospetto' soltanto quando l'alterazione appare chiaramente innaturale, globale e difficilmente spiegabile con illuminazione, materiali o colori plausibili della scena. Se non riesci a distinguere con sufficiente affidabilità una dominante artificiale da una caratteristica reale dell'ambiente, restituisci 'incerto'. Se la resa cromatica appare plausibile, restituisci 'normale'. La motivazione deve essere breve, prudente e riferita esclusivamente a ciò che è visibile.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"esito_colore\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"normale\",\n            \"sospetto\",\n            \"incerto\"\n          ]\n        },\n        \"anomalia_colore\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"nessuna\",\n            \"troppo_calda\",\n            \"troppo_fredda\",\n            \"troppo_satura\",\n            \"troppo_desaturata\",\n            \"dominante_colore\",\n            \"altro\"\n          ]\n        },\n        \"confidenza\": {\n          \"type\": \"number\"\n        },\n        \"motivazione\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"esito_colore\",\n        \"anomalia_colore\",\n        \"confidenza\",\n        \"motivazione\"\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        160,
        -64
      ],
