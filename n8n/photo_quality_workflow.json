        "jsCode": "if (!$json.data?.[0]?.b64_json) {\n  throw new Error(\n    `Output OpenAI mancante per: ${$json.photo_id ?? $json.id ?? 'foto sconosciuta'}`\n  );\n}\n\nconst b64 = $json.data[0].b64_json;\nconst usage = $json.usage ?? {};\n\nconst startedMs = Number($json.l4_started_ms);\n\nconst apiLatencyMs = Number.isFinite(startedMs)\n  ? Date.now() - startedMs\n  : null;\n\n// Togliamo solo il payload base64 dal JSON,\n// ma conserviamo TUTTI gli altri campi originali\nconst { data, ...origine } = $json;\n\nreturn {\n  json: {\n    ...origine,\n\n    id_foto: $json.id,\n\n    l4_started_ms: startedMs,\n    api_latency_ms: apiLatencyMs,\n\n    input_tokens: usage.input_tokens ?? null,\n    output_tokens: usage.output_tokens ?? null,\n    total_tokens: usage.total_tokens ?? null,\n\n    usage\n  },\n\n  binary: {\n    data: {\n      data: b64,\n      mimeType: 'image/png',\n      fileName: `L4_${$json.photo_id}.png`\n    }\n  }\n};"
      },
